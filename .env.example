# Where the booking/contact form posts its enquiries.
# Set this to the cPanel mail handler once it exists, e.g.
#   VITE_CONTACT_ENDPOINT=https://khumbulodge.com/contact.php
#
# It receives a JSON POST body:
#   { "firstName": "...", "lastName": "...", "email": "...", "message": "..." }
# and should reply 2xx on success, any other status on failure.
#
# While this is unset the form falls back to opening the guest's own mail app
# with the enquiry pre-filled, so no message is silently dropped.
VITE_CONTACT_ENDPOINT=
